{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aktsmm/Ag-Ext-AI-Agent-Bookmark-Manager/schemas/bookmark-plan.schema.json",
  "title": "AI agent bookmark plan",
  "type": "object",
  "required": ["version", "operations"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "enum": [1, 2],
      "description": "Version 1 is move-only. Version 2 also allows update operations; a version 1 document cannot carry one."
    },
    "generatedAt": {
      "type": "string",
      "description": "ISO 8601 timestamp of plan generation."
    },
    "generatedBy": { "type": "string" },
    "notes": { "type": "string" },
    "operations": {
      "type": "array",
      "description": "May be empty when the agent decided every candidate should stay where it is; explain that in notes.",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/moveOperation" },
          { "$ref": "#/$defs/updateOperation" }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "const": 1 } } },
      "then": {
        "properties": {
          "operations": { "items": { "$ref": "#/$defs/moveOperation" } }
        }
      }
    }
  ],
  "$defs": {
    "moveOperation": {
      "type": "object",
      "required": [
        "opId",
        "type",
        "bookmarkId",
        "expectedTitle",
        "expectedUrl",
        "currentPath",
        "destinationPath",
        "reason",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "opId": { "type": "string", "minLength": 1 },
        "type": { "const": "move" },
        "bookmarkId": { "type": "string", "minLength": 1 },
        "expectedTitle": { "type": "string" },
        "expectedUrl": {
          "type": ["string", "null"],
          "description": "null for folders."
        },
        "currentPath": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Path segments from the permanent root, excluding the tree root."
        },
        "destinationPath": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Path segments of an existing folder. Must resolve to exactly one folder unless destinationFolderId is also supplied."
        },
        "destinationFolderId": {
          "type": "string",
          "description": "Required when destinationPath is shared by more than one folder. When present, the folder it identifies must have exactly this path in the live tree; a disagreement is a hard validation error, not a precedence rule."
        },
        "reason": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "updateOperation": {
      "type": "object",
      "description": "Renames one bookmark. Folders are refused: a folder title is a path segment for everything beneath it. The url is never writable.",
      "required": [
        "opId",
        "type",
        "bookmarkId",
        "expectedTitle",
        "expectedUrl",
        "currentPath",
        "newTitle",
        "reason",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "opId": { "type": "string", "minLength": 1 },
        "type": { "const": "update" },
        "bookmarkId": { "type": "string", "minLength": 1 },
        "expectedTitle": { "type": "string" },
        "expectedUrl": {
          "type": ["string", "null"],
          "description": "A null here means the node is a folder, which this version refuses to rename."
        },
        "currentPath": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Path segments from the permanent root, excluding the tree root."
        },
        "newTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "The title to write. Must differ from the live title."
        },
        "reason": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
